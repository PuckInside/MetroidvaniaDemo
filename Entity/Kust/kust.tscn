[sub_resource type="GDScript" id="GDScript_q6cx6"]
resource_name = "kust"
script/source = "extends CharacterBody2D

const WAIT := 0
const BITE := 1
const KNOCKBACK := 9

@export var max_health: int = 60
@export var bite_cooldown: float = 3.0
@onready var _wait := KustWait.new(self, $Area2D, bite_cooldown)
@onready var _bite := KustBite.new(self, $Hitbox, 0.3, 0.3)
@onready var _knockback := KnockbackState.new(self)
@onready var _animation = $AnimatedSprite2D

var health: Health = Health.new(max_health)
var _state_machine: StateMachine

func _ready() -> void:
	_wait.finished.connect(func(): _state_machine.change_state(BITE))
	_bite.finished.connect(func(): _state_machine.change_state(WAIT))
	_knockback.finished.connect(func(): _state_machine.change_state(WAIT))
	
	_state_machine = StateMachine.new(_wait, WAIT)
	_state_machine.add_state(_bite, BITE)
	_state_machine.add_state(_knockback, KNOCKBACK)
	health.death.connect(_on_death)

func _physics_process(delta: float) -> void:
	match _state_machine.get_state_id():
		WAIT: _animation.play(\"idle\")
		BITE: _animation.play(\"bite\")
		KNOCKBACK: _animation.play(\"damaged\")
	
	_state_machine.physics_update(delta)

func _on_death() -> void:
	set_physics_process(false)
	$Hitbox.queue_free()
	$HurtBox.queue_free()
	$CollisionShape2D.queue_free()
	$AnimatedSprite2D.play(\"death\")
	await $AnimatedSprite2D.animation_finished
	queue_free()

func _on_hurt_box_damaged(damage: int, _force: Vector2, _duration: float) -> void:
	health.health_point -= damage
	$RockParticles.emitting = true
	_knockback.setup(Vector2.ZERO, 1.0)
	_state_machine.change_state(KNOCKBACK)
"

