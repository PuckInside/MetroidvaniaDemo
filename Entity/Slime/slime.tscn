[sub_resource type="GDScript" id="GDScript_j8x4d"]
resource_name = "Slime"
script/source = "extends CharacterBody2D

var facing: float = 1.0
var disabled: bool = false

func _ready() -> void:
	$Hitbox.area_entered.connect(_on_deal_damage)
	$Health.health_changed.connect(_on_get_damage)
	$Health.death.connect(_on_death)

func _physics_process(_delta: float) -> void:
	if velocity.x > 0:
		$AnimatedSprite2D.flip_h = false
	if velocity.x < 0:
		$AnimatedSprite2D.flip_h = true
	
	if is_on_wall():
		facing *= -1.0
	
	if not disabled:
		velocity = Movement.get_move(velocity, facing, 300.0)
	else:
		velocity = Movement.get_brake(velocity, 600.0)
	
	velocity = Movement.get_gravity(velocity, _delta)
	move_and_slide()

func _on_deal_damage(_body: Area2D) -> void:
	facing *= -1.0

func _on_get_damage(_hp: int) -> void:
	
	facing *= -1.0
	disabled = true
	await get_tree().create_timer(0.2).timeout
	disabled = false

func _on_death() -> void:
	set_physics_process(false)
	$Hitbox.queue_free()
	$HurtBox.queue_free()
	$AnimatedSprite2D.play(\"death\")
	await get_tree().create_timer(1).timeout
	queue_free()
"

