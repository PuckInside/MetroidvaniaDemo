[sub_resource type="GDScript" id="GDScript_x1f5c"]
resource_name = "PlayerAnimations"
script/source = "extends AnimatedSprite2D

@export var player: PlayerController

func _ready() -> void:
	assert(player is PlayerController)

func _process(_delta: float) -> void:
	if player.facing > 0.0:
		flip_h = false
	if player.facing < 0.0:
		flip_h = true
	
	match player.get_state_id():
		player.States.IDLE: play(\"idle\")
		player.States.WALK: play(\"run\")
		player.States.JUMP: play(\"rise\")
		player.States.DASH: play(\"dash\") 
		player.States.MELEE_ATTACK: play(\"attack\")
		player.States.RANGE_ATTACK: play(\"shot\")
	
	var can_fall := player.get_state_id() in [player.States.IDLE, player.States.WALK]
	if not player.is_on_floor() and player.velocity.y >= 300.0 and can_fall:
		play(\"fall\")
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_jksyu"]
