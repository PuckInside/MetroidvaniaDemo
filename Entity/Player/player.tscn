[sub_resource type="GDScript" id="GDScript_eiw37"]
resource_name = "ShotHitbox"
script/source = "extends Hitbox

@export var miss_range: float = 900.0
@export var hit_range: float = 300.0
@export var accuracy: Curve

var _random = RandomNumberGenerator.new()
var _chance = 1.0

func _ready() -> void:
	super._ready()
	assert(accuracy is Curve)

func deal_damage(lifetime: float) -> void:
	super.deal_damage(lifetime)
	_chance = _random.randf_range(0.1, 1.0)

func _on_area_entered(hurtbox: HurtBox) -> void:
	if not hurtbox is HurtBox:
		return
	if hurtbox.owner == self.owner:
		return
	
	var self_pos = owner.global_position 
	var target_pos = hurtbox.global_position
	var direction = sign(target_pos.x - self_pos.x)
	var distance = abs(target_pos.x - self_pos.x)
	
	if distance >= 300.0 or _chance <= accuracy.sample(distance / miss_range):
		var velocity = Vector2(direction * force_velocity, 0.0)
		velocity = Movement.get_jump(velocity, force_height)
		hurtbox.take_damage(damage, velocity, disable_duration)
"

