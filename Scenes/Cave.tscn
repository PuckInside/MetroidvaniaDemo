[sub_resource type="GDScript" id="GDScript_yw2ac"]
resource_name = "Cavev"
script/source = "extends Node2D

@export var player: PlayerController

func _ready() -> void:
	assert(player is PlayerController)
	player.health.death.connect(_on_player_death)

func _on_player_death() -> void:
	var current_scene_path = get_tree().current_scene.scene_file_path
	get_tree().call_deferred(\"change_scene_to_file\", current_scene_path)
"

[sub_resource type="GDScript" id="GDScript_q6vw4"]
resource_name = "UI"
script/source = "extends CanvasLayer

@export var player: PlayerController

func _ready() -> void:
	assert(player is PlayerController)
	$MarginContainer/VBoxContainer/HP.max_value = player.health.max_health
	$MarginContainer/VBoxContainer/Shot.max_value = player.cartridges

func _process(_delta: float) -> void:
	$MarginContainer/VBoxContainer/HP.value = player.health.health_point
	$MarginContainer/VBoxContainer/Shot.value = player.cartridges
"

