[sub_resource type="GDScript" id="GDScript_gsklp"]
resource_name = "DoubleJumpBonus"
script/source = "extends Sprite2D

func _ready() -> void:
	var area := $Area2D
	area.body_entered.connect(_on_pickup)

func _on_pickup(player: PlayerController) -> void:
	if not player is PlayerController:
		return
	
	player.double_jump = true
	queue_free()
"

