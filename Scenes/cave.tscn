[sub_resource type="GDScript" id="GDScript_i8nqp"]
script/source = "extends TextureProgressBar

@export var player: PlayerController

func _ready() -> void:
	player.health.health_changed.connect(func(hp: int): value = hp)
"

[sub_resource type="GDScript" id="GDScript_826tw"]
script/source = "extends TextureProgressBar

@export var player: PlayerController

func _ready() -> void:
	max_value = player.max_cartridges

func _process(_delta: float) -> void:
	value = player.cartridges
"

