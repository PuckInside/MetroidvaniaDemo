[gd_scene format=3 uid="uid://dqsqbw7jrvmv6"]

[sub_resource type="GDScript" id="GDScript_u4yt8"]
resource_name = "GameMenu"
script/source = "extends Node2D

const SCENE_PATH = \"res://Scenes/cave.tscn\"

@onready var play: Button = $CanvasLayer/MarginContainer/VBoxContainer/Button
@onready var exit: Button = $CanvasLayer/MarginContainer/VBoxContainer/Button2

func _ready() -> void:
	play.pressed.connect(_to_play)
	exit.pressed.connect(_to_exit)

func _to_play() -> void:
	get_tree().call_deferred(\"change_scene_to_file\", SCENE_PATH)

func _to_exit() -> void:
	get_tree().quit()
"

